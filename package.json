{
  "name": "ledger360",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/tests/**/*.integration.test.ts --exclude src/tests/**/*.stress.ts",
    "test:integration": "vitest run \"src/tests/**/*.integration.test.ts\" --passWithNoTests",
    "test:stress": "vitest run \"src/tests/**/*.stress.ts\" --passWithNoTests",
    "benchmark": "npx tsx --env-file=.env src/scripts/benchmarks/runner.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "verify": "npm run lint && npx tsc --noEmit && npm run test:unit && npm run build"
  },
  "dependencies": {
