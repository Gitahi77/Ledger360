# Database (Postgres / Neon)
DATABASE_URL="postgres://user:password@hostname/db?pgbouncer=true"            # POOLED connection — used at runtime
DIRECT_DATABASE_URL="postgres://user:password@hostname/db"                     # DIRECT connection — used only by Prisma CLI / migrations

# Auth
NEXTAUTH_SECRET="your_nextauth_secret_here"                                    # generate: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"                                           # LOCAL: http://localhost:3000 | PRODUCTION: set in Vercel dashboard (Settings → Env Vars), NOT in vercel.json
NEXT_PUBLIC_APP_URL="http://localhost:3000"                                    # public base URL for emails/links

# Email (Resend)
RESEND_API_KEY="re_123456789"                                                  # your Resend API key for transaction emails

# AI (Google Gemini — use a data-governed/paid tier; see WO-6)
GOOGLE_GENERATIVE_AI_API_KEY="AIzaSyYourGoogleGenAIKeyHere"                    # your Google Generative AI API Key
GEMINI_MODEL="gemini-2.5-pro"                                                  # configurable model id (see WO-6); do not hardcode in source

# Rate limiting / cache (Upstash Redis) — added in WO-5
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"             # your Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"                       # your Upstash Redis REST Token

# Error monitoring (Sentry) — added in WO-5
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"                    # your Sentry DSN for error tracking
