generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accountType   String    @default("individual") // "individual" | "corporate"
  currency      String    @default("KES")

  resetToken       String?
  resetTokenExpiry DateTime?
  sessionVersion   Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  oauthAccounts OAuthAccount[]
  sessions      Session[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
  loans         Loan[]
  assets        Asset[]
  auditLogs     AuditLog[]
  preferences   UserPreferences?
  transfers     Transfer[]
  savingsPlan   SavingsPlan?
}

// ── User Preferences (persisted settings) ────────────────────
// One-to-one with User. Created on first settings save via upsert.
model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Appearance
  accentColor String  @default("#1A73E8")
  compactMode Boolean @default(false)
  smoothAnims Boolean @default(true)

  // Preferences
  dateFormat   String @default("DD/MM/YYYY") // "DD/MM/YYYY" | "MM/DD/YYYY" | "YYYY-MM-DD"
  weekStartDay String @default("Monday") // "Monday" | "Sunday"
  savingRate   Int    @default(30) // % of income target
  expectedMonthlyIncomeMinor Int? // optional override for safe-to-spend expected income

  // Notification flags (in-app)
  notifOverbudget Boolean @default(true)
  notifGoals      Boolean @default(true)
  notifBills      Boolean @default(true)
  notifInsights   Boolean @default(false)
  notifLoanDue    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         String
  currency     String
  openingMinor Int           @default(0)
  archived     Boolean       @default(false)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  transfersFrom Transfer[]   @relation("TransferFrom")
  transfersTo   Transfer[]   @relation("TransferTo")
  savingsPlanFrom SavingsPlan[] @relation("SavingsPlanFrom")
  savingsPlanTo   SavingsPlan[] @relation("SavingsPlanTo")
  createdAt    DateTime      @default(now())

  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Finance ──────────────────────────────────────────────────
model Category {
  id           String        @id @default(cuid())
  name         String
  type         String // "income" | "expense" | "savings"
  icon         String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([name, userId])
}

model Transaction {
  id              String    @id @default(cuid())
  date            DateTime
  baseAmountMinor Int // stored as integer minor units (cents)
  currency        String    @default("KES")
  type            String // "income" | "expense"
  name            String
  note            String?
  categoryId      String
  accountId       String
  userId          String
  importedAt      DateTime? // non-null if imported via Smart Upload
  importHash      String?   // dedup key (WO-11)
  reference       String?   // source transaction reference (WO-11)

  category Category @relation(fields: [categoryId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, date(sort: Desc)])
}

model Budget {
  id               String @id @default(cuid())
  name             String
  period           String @default("monthly") // "weekly" | "monthly" | "yearly"
  limitAmountMinor Int // stored as integer minor units (cents)
  rollover         Boolean @default(false)
  categoryId       String
  userId           String

  category Category @relation(fields: [categoryId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([categoryId, period, userId])
}

model Goal {
  id                 String    @id @default(cuid())
  name               String
  category           String
  targetAmountMinor  Int // stored as integer minor units (cents)
  deadline           DateTime?
  userId             String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  transfers Transfer[]
  savingsPlans SavingsPlan[]
}

model Loan {
  id                  String   @id @default(cuid())
  name                String
  lender              String
  type                String // "Personal" | "Student" | "Mortgage" | "Credit Card" | "Informal"
  originalAmountMinor Int // stored as integer minor units (cents)
  balanceMinor        Int
  annualRate          Float    @default(0) // percentage, NOT money
  monthlyPaymentMinor Int
  nextDue             DateTime
  userId              String

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())
  transfers Transfer[]

  @@index([userId])
}

model Asset {
  id         String @id @default(cuid())
  name       String
  category   String // "Liquid" | "Investment" | "Property"
  valueMinor Int // stored as integer minor units (cents)
  userId     String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Security / Activity Logging ──────────────────────────────
model AuditLog {
  id        String  @id @default(cuid())
  userId    String
  action    String // e.g., "LOGIN", "IMPORT_TRANSACTIONS", "DELETE_BUDGET"
  resource  String // e.g., "Auth", "Transaction", "Budget"
  metadata  String? // JSON stringified details
  ipAddress String?

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

model Transfer {
  id              String   @id @default(cuid())
  userId          String
  fromAccountId   String?
  toAccountId     String?
  amountMinor     Int
  currency        String
  baseAmountMinor Int
  fxRate          Decimal  @db.Decimal(10, 6)
  date            DateTime
  note            String?
  source          String   @default("MANUAL") // MANUAL, IMPORT, SYSTEM, SAVE_MORE_TOMORROW
  goalId          String?
  sourceTransactionId String? @unique          // WO-15: idempotency — links auto-save to the income that triggered it
  loanId          String?
  interestMinor   Int      @default(0)
  createdAt       DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account? @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account? @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  loan        Loan?    @relation(fields: [loanId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([fromAccountId])
  @@index([toAccountId])
}

// ── SavingsPlan: Save-More-Tomorrow commitment device (B-5, WO-15) ──
model SavingsPlan {
  id             String   @id @default(cuid())
  userId         String   @unique              // one plan per user
  fromAccountId  String                        // source (e.g. M-Pesa, salary account)
  toAccountId    String                        // destination — must be savings/investment type, OR goalId must be set
  goalId         String?                       // optional: auto-save funds this goal
  baseRatePct    Int      @default(10)         // initial rate (seeded from UserPreferences.savingRate)
  escalationPct  Int      @default(1)          // bump per period (percentage points)
  maxRatePct     Int      @default(30)         // ceiling
  currentRatePct Int      @default(10)         // active rate (seeded from UserPreferences.savingRate)
  nextEscalation DateTime                      // when the next bump happens
  active         Boolean  @default(true)       // pause toggle
  createdAt      DateTime @default(now())

  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account @relation("SavingsPlanFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("SavingsPlanTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  goal        Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
}
