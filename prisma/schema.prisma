generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Auth ────────────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  accountType   String    @default("individual") // "individual" | "corporate"
  currency      String    @default("KES")
  
  resetToken       String?
  resetTokenExpiry DateTime?
  sessionVersion   Int       @default(1)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  goals         Goal[]
  loans         Loan[]
  assets        Asset[]
  auditLogs     AuditLog[]
  preferences   UserPreferences?
}

// ── User Preferences (persisted settings) ────────────────────
// One-to-one with User. Created on first settings save via upsert.
model UserPreferences {
  id           String  @id @default(cuid())
  userId       String  @unique
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Appearance
  accentColor  String  @default("#1A73E8")
  compactMode  Boolean @default(false)
  smoothAnims  Boolean @default(true)

  // Preferences
  dateFormat   String  @default("DD/MM/YYYY")   // "DD/MM/YYYY" | "MM/DD/YYYY" | "YYYY-MM-DD"
  weekStartDay String  @default("Monday")        // "Monday" | "Sunday"
  savingRate   Int     @default(30)              // % of income target

  // Notification flags (in-app)
  notifOverbudget Boolean @default(true)
  notifGoals      Boolean @default(true)
  notifBills      Boolean @default(true)
  notifInsights   Boolean @default(false)
  notifLoanDue    Boolean @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Finance ──────────────────────────────────────────────────
model Category {
  id           String        @id @default(cuid())
  name         String
  type         String        // "income" | "expense" | "savings"
  icon         String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([name, userId])
}

model Transaction {
  id               String   @id @default(cuid())
  date             DateTime
  baseAmountMinor  Int      // stored as integer minor units (cents)
  currency         String   @default("KES")
  type             String   // "income" | "expense"
  name             String
  note             String?
  categoryId       String
  userId           String
  importedAt       DateTime? // non-null if imported via Smart Upload

  category Category @relation(fields: [categoryId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, date(sort: Desc)])
}

model Budget {
  id               String   @id @default(cuid())
  name             String
  period           String   @default("monthly") // "weekly" | "monthly" | "yearly"
  limitAmountMinor Int      // stored as integer minor units (cents)
  categoryId       String
  userId           String

  category Category @relation(fields: [categoryId], references: [id])
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([categoryId, period, userId])
}

model Goal {
  id                  String    @id @default(cuid())
  name                String
  category            String
  targetAmountMinor   Int       // stored as integer minor units (cents)
  currentAmountMinor  Int       @default(0)
  deadline            DateTime?
  userId              String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Loan {
  id                    String   @id @default(cuid())
  name                  String
  lender                String
  type                  String   // "Personal" | "Student" | "Mortgage" | "Credit Card" | "Informal"
  originalAmountMinor   Int      // stored as integer minor units (cents)
  balanceMinor          Int
  annualRate            Float    @default(0)  // percentage, NOT money
  monthlyPaymentMinor   Int
  nextDue               DateTime
  daysOverdue           Int      @default(0)
  userId                String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  category    String   // "Liquid" | "Investment" | "Property"
  valueMinor  Int      // stored as integer minor units (cents)
  userId      String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Security / Activity Logging ──────────────────────────────
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // e.g., "LOGIN", "IMPORT_TRANSACTIONS", "DELETE_BUDGET"
  resource  String   // e.g., "Auth", "Transaction", "Budget"
  metadata  String?  // JSON stringified details
  ipAddress String?
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}
